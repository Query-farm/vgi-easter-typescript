{
  "name": "@query-farm/vgi-easter",
  "version": "0.1.0",
  "description": "VGI worker that computes the date of Western (Gregorian) Easter Sunday for a given year.",
  "license": "MIT",
  "author": "Query Farm LLC (https://query.farm)",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "main": "dist/worker.js",
  "types": "dist/worker.d.ts",
  "bin": {
    "vgi-easter": "dist/worker.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:types": "bunx tsc -p tsconfig.json",
    "build:js": "bun build ./src/worker.ts ./src/serve.ts --outdir dist --target node --format esm --sourcemap=external --external @query-farm/apache-arrow --external @query-farm/vgi-rpc --external @query-farm/vgi",
    "test": "bun test",
    "start": "bun run src/serve.ts",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@query-farm/vgi": "file:./vendor-query-farm-vgi-0.1.0.tgz",
    "@query-farm/apache-arrow": "^21.1.1",
    "@query-farm/vgi-rpc": "^0.7.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
