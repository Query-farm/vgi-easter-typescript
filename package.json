{
  "name": "@query-farm/vgi-easter",
  "version": "0.2.0",
  "description": "VGI worker that computes the date of Western (Gregorian) Easter Sunday for a given year.",
  "license": "MIT",
  "author": "Query Farm LLC (https://query.farm)",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "main": "dist/worker.js",
  "types": "dist/worker.d.ts",
  "bin": {
    "vgi-easter": "bin/vgi-easter"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:types && bun run build:js && bun run build:worker-cjs",
    "build:types": "bunx tsc -p tsconfig.json",
    "build:js": "bun build ./src/worker.ts ./src/serve.ts --outdir dist --target node --format esm --sourcemap=external --external @query-farm/apache-arrow --external @query-farm/vgi-rpc --external @query-farm/vgi",
    "build:worker-cjs": "esbuild ./src/worker-stdio.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/worker.cjs --sourcemap=external --define:import.meta.url=__vgiImportMetaUrl --banner:js=\"const __vgiImportMetaUrl=require('node:url').pathToFileURL(__filename).href;\"",
    "test": "bun test",
    "start": "bun run src/serve.ts",
    "worker": "node dist/worker.cjs"
  },
  "dependencies": {
    "@query-farm/vgi": "^0.49.1",
    "@query-farm/apache-arrow": "^21.1.1",
    "@query-farm/vgi-rpc": "^0.29.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
